{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": { "python": "3.12" },
  "steps": {
    "build": {
      "commands": [
        "python -m venv /app/.venv",
        "/app/.venv/bin/python -m pip install --no-cache-dir ."
      ]
    }
  },
  "deploy": {
    "inputs": ["...", { "step": "build", "include": ["/app/.venv"] }],
    "paths": ["/app/.venv/bin"],
    "startCommand": "exec python -m ayloor_bot"
  }
}
