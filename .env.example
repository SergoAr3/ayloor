ENVIRONMENT=development
POSTGRES_USER=ayloor
POSTGRES_PASSWORD=ayloor-local-only
POSTGRES_DB=ayloor
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ayloor:ayloor-local-only@localhost:5432/ayloor
# Dedicated disposable test database; never point this at your application DB.
TEST_DATABASE_URL=postgresql+asyncpg://ayloor:ayloor-local-only@localhost:5432/ayloor_test
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_BOT_USERNAME=replace_with_bot_username
TELEGRAM_WEBAPP_URL=https://replace-with-your-https-miniapp-url.example
# Reserved for a future webhook deployment; v0.1 bot uses polling.
TELEGRAM_WEBHOOK_SECRET=
APP_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRATION_MINUTES=60
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
MAX_ACCEPTABLE_GPS_ACCURACY_M=150
# Comma-separated positive Telegram user IDs, e.g. 123456789,987654321.
ADMIN_TELEGRAM_IDS=
CORS_ORIGINS=http://localhost:5173
# Development: empty uses Vite's /api proxy (including local HTTPS tunnels).
# Production build: required public HTTPS backend origin, without /api/v1.
VITE_API_BASE_URL=
